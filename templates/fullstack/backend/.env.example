# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=file:./database.sqlite

# Authentication
# AUTH_SECRET must be at least 32 characters — change this before deploying!
AUTH_SECRET=change-this-development-secret-32-chars
AUTH_STRATEGY=jwt
SESSION_MODE=multiple

# Optional: OAuth Providers
# Uncomment and configure the providers you want to use.

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google

# GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/callback/github

# Apple
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/apple

# Microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/callback/microsoft

# Discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/callback/discord
