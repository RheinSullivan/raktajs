{
	"framework": "Rakta.js",
	"version": "1.1.4",
	"website": "https://raktajs.dev",
	"npm": "create-rakta",
	"repository": "https://github.com/RheinSullivan/raktajs_framework",
	"runtime": "bun",
	"renderer": "react",
	"language": "typescript",
	"license": "MIT",
	"tagline": "Small in size. Fierce in speed. Alive in every route.",
	"detection": {
		"headers": {
			"x-powered-by": "Rakta.js",
			"x-generator": "Rakta.js/{version}",
			"x-rakta-version": "{version}"
		},
		"html": [
			"<!-- Generated by Rakta.js",
			"data-framework=\"raktajs\"",
			"<meta name=\"generator\" content=\"Rakta.js\""
		],
		"js_globals": ["window.__RAKTA__"],
		"dom": ["#rakta-root[data-rakta]"]
	}
}
