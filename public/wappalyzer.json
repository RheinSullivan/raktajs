{
	"Rakta.js": {
		"cats": [12],
		"description": "Rakta.js is a modern JavaScript framework for React applications, Bun-powered tooling, typed routing, rendering, SEO, PWA, RPC, stores, schema validation, and auto imports.",
		"website": "https://raktajs.dev",
		"icon": "Rakta.js.svg",
		"oss": true,
		"headers": {
			"x-generator": "^Rakta\\.js\\/([\\d.]+)$\\;version:\\1",
			"x-powered-by": "^Rakta\\.js$",
			"x-rakta-version": "^([\\d.]+)$\\;version:\\1"
		},
		"html": [
			"<html[^>]+data-framework=[\"']raktajs[\"']",
			"<div[^>]+id=[\"']rakta-root[\"'][^>]+data-rakta(?:=[\"'][^\"']*[\"'])?",
			"<meta[^>]+name=[\"']generator[\"'][^>]+content=[\"']Rakta\\.js[\"']",
			"Generated by Rakta\\.js v([\\d.]+)\\;version:\\1"
		],
		"dom": {
			"html[data-framework='raktajs']": {
				"exists": ""
			},
			"#rakta-root[data-rakta]": {
				"exists": ""
			}
		},
		"js": {
			"window.__RAKTA__": "",
			"window.__RAKTA__.version": "^([\\d.]+)$\\;version:\\1"
		},
		"meta": {
			"generator": "^Rakta\\.js$"
		}
	}
}
