{
	"Rakta.js": {
		"cats": [1],
		"description": "Rakta.js is a modern full-stack JavaScript framework built with React, Bun, and TypeScript. Small in size. Fierce in speed. Alive in every route.",
		"website": "https://raktajs.dev",
		"icon": "raktajs.svg",
		"cpe": "cpe:2.3:a:raktajs:rakta.js:*:*:*:*:*:*:*:*",
		"headers": {
			"x-powered-by": "Rakta\\.js",
			"x-generator": "Rakta\\.js",
			"x-rakta-version": ""
		},
		"html": [
			"<!--[^>]*Generated by Rakta\\.js",
			"<[^>]+data-framework=[\"']raktajs[\"']",
			"<meta[^>]+name=[\"']generator[\"'][^>]+content=[\"']Rakta\\.js[\"']"
		],
		"dom": {
			"#rakta-root": {
				"attributes": {
					"data-rakta": ""
				}
			}
		},
		"js": {
			"window.__RAKTA__": "",
			"window.__RAKTA__.version": "([\\d.]+)\\;version:\\1"
		},
		"scriptSrc": "rakta",
		"implies": ["React", "Bun"],
		"pricing": ["freemium", "open-source"],
		"oss": true
	}
}
