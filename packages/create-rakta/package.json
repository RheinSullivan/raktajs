{
	"name": "create-rakta-app",
	"version": "1.2.4",
	"description": "Create Rakta.js apps instantly - Interactive CLI for React fullstack projects with SSR, TypeScript, Bun, and modern tooling. Zero config required.",
	"type": "module",
	"license": "MIT",
	"author": "Rhein Sullivan | Vyagra Nexusâ„¢",
	"homepage": "https://raktajs.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RheinSullivan/raktajs.git",
		"directory": "packages/create-rakta"
	},
	"bugs": {
		"url": "https://github.com/RheinSullivan/raktajs/issues"
	},
	"keywords": [
		"rakta",
		"create-rakta-app",
		"react-scaffold",
		"fullstack-cli",
		"project-generator",
		"typescript-starter",
		"bun-create",
		"next-alternative",
		"interactive-cli",
		"zero-config",
		"modern-stack",
		"web-framework-cli"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"bin": {
		"create-rakta-app": "dist/index.js"
	},
	"files": [
		"dist",
		"assets",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "bun run ./src/index.ts",
		"build": "bun run ./scripts/build.ts",
		"typecheck": "tsc -p ./tsconfig.json --noEmit && tsc -p ./scripts/tsconfig.json --noEmit",
		"prepublishOnly": "bun run build && bun run typecheck"
	},
	"dependencies": {
		"@clack/prompts": "^1.6.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.1",
		"typescript": "^6.0.3"
	}
}
